<Window x:Class="Bap.Companion.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAP Companion" Icon="Assets/bap-companion.ico" Width="1220" Height="790" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#07142D" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Muted" Color="#9AB0D0"/>
    <SolidColorBrush x:Key="Accent" Color="#22D3FF"/>
    <SolidColorBrush x:Key="Border" Color="#284572"/>
    <SolidColorBrush x:Key="NavSelected" Color="#143961"/>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1A6BFF" Offset="0"/>
      <GradientStop Color="#594CE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#102B61" Offset="0"/>
      <GradientStop Color="#11234D" Offset="0.55"/>
      <GradientStop Color="#33225E" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#0E2042"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#142F58"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B4274"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,10"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderBrush="#477EFF" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#19335E"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#132B51"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
              <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#36D8FF" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
              <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=Box}"
                 AllowsTransparency="True" StaysOpen="False" Focusable="False">
            <Border Background="#132B51" BorderBrush="#397CB6" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, ElementName=Box}" MaxHeight="340" Margin="0,3,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#36D8FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="Transparent" Padding="11,9" CornerRadius="6">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#1B4070"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#1D4A7D"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="CatalogList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Card" Background="#12284C" BorderBrush="#2A4775" BorderThickness="1" CornerRadius="12" Padding="12">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#397CB6"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#153763"/><Setter TargetName="Card" Property="BorderBrush" Value="#22D3FF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
        <Grid Height="92"><Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#0A1C3B" CornerRadius="8" ClipToBounds="True">
            <Grid><Image Source="{Binding Preview}" Stretch="UniformToFill"/>
              <TextBlock Text="{Binding NoPreview}" Foreground="#9AB0D0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,5,0,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#EAF3FF" TextTrimming="CharacterEllipsis" FontSize="15"/>
            <TextBlock Text="{Binding Source}" Foreground="#9AB0D0" Margin="0,7,0,0"/>
            <TextBlock Text="{Binding Summary}" Foreground="#36D8FF" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SelectorList" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="12,10">
            <ContentPresenter HorizontalAlignment="Stretch"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18345C"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B4070"/><Setter Property="Foreground" Value="#36D8FF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#081631" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="5,0,5,34">
          <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Left">
            <Image Source="Assets/bap-logo.png" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="BAP Companion" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,13,0,1"/>
          <TextBlock x:Name="AppSubtitle" Style="{StaticResource Hint}" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
          <Button x:Name="InstalledNav" Style="{StaticResource NavButton}" Click="InstalledNav_Click"/>
          <Button x:Name="PresetsNav" Style="{StaticResource NavButton}" Click="PresetsNav_Click"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Background="{StaticResource BrandGradient}" Padding="12" Margin="0,0,0,8">
          <StackPanel><TextBlock Text="BAP" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="SidebarServiceStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,25,30,26">
      <Grid x:Name="InstalledPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource BrandGradient}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="19" Margin="0,0,0,22">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="InstalledTitle" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="CatalogHint" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
          <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="RefreshButton_Click" VerticalAlignment="Center"/>
        </Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
            <StackPanel>
              <TextBlock x:Name="HostsHeading" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
              <ListBox x:Name="HostsList" Style="{StaticResource CatalogList}" SelectionChanged="Catalog_SelectionChanged"/>
              <TextBlock x:Name="NoHosts" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
              <TextBlock x:Name="ComponentsHeading" Style="{StaticResource SectionHeading}" Margin="0,18,0,12"/>
              <ListBox x:Name="ComponentsList" Style="{StaticResource CatalogList}" SelectionChanged="Catalog_SelectionChanged"/>
              <TextBlock x:Name="NoComponents" Style="{StaticResource Hint}"/>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="19">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock x:Name="DetailsHeading" Style="{StaticResource SectionHeading}" Margin="0,0,0,14"/>
              <TextBlock x:Name="DetailEmpty" Style="{StaticResource Hint}"/>
              <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                <Border Height="168" Background="#0A1C3B" CornerRadius="9" ClipToBounds="True" Margin="0,0,0,17"><Image x:Name="DetailPreview" Stretch="UniformToFill"/></Border>
                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/>
                <TextBlock x:Name="DetailMetadata" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="25"/>
                <TextBlock x:Name="LocationLabel" Style="{StaticResource Hint}" Margin="0,16,0,5"/>
                <TextBlock x:Name="DetailPath" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                <StackPanel x:Name="HostActions" Margin="0,20,0,0">
                  <Button x:Name="SwitchHostButton" Style="{StaticResource PrimaryButton}" Click="SwitchHostButton_Click"/>
                  <TextBlock x:Name="SwitchStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="PresetsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource BrandGradient}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="19" Margin="0,0,0,22">
          <StackPanel><TextBlock x:Name="PresetsTitle" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="PresetIntro" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*" MinWidth="270"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="15" Margin="0,0,12,0"><DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button x:Name="NewPresetButton" Style="{StaticResource PrimaryButton}" Click="NewPresetButton_Click" Margin="0,0,0,7"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="RenameButton" Style="{StaticResource QuietButton}" Click="RenameButton_Click" Margin="0,0,4,0"/>
                <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="DeleteButton_Click" Margin="4,0,0,0"/>
              </Grid>
            </StackPanel>
            <ListBox x:Name="PresetList" Style="{StaticResource SelectorList}" SelectionChanged="PresetList_SelectionChanged"/>
          </DockPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="15" Margin="0,0,12,0"><DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <ComboBox x:Name="AvailableComponents" Margin="0,0,0,8">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="AddComponentButton" Style="{StaticResource PrimaryButton}" Click="AddComponentButton_Click"/>
            </StackPanel>
            <StackPanel><TextBlock x:Name="SelectedComponentsHeading" Style="{StaticResource SectionHeading}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <ListBox x:Name="SelectedComponents" Style="{StaticResource SelectorList}" Height="300">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="RemoveComponentButton" Style="{StaticResource QuietButton}" Click="RemoveComponentButton_Click" Margin="0,0,4,0"/>
                <Button x:Name="MoveUpButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="MoveUpButton_Click" Margin="4,0"/>
                <Button x:Name="MoveDownButton" Grid.Column="2" Style="{StaticResource QuietButton}" Click="MoveDownButton_Click" Margin="4,0,0,0"/>
              </Grid>
            </StackPanel>
          </DockPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="15"><StackPanel>
            <TextBlock x:Name="ScopeHeading" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
            <Button x:Name="SetGlobalButton" Style="{StaticResource PrimaryButton}" Click="SetGlobalButton_Click"/>
            <TextBlock x:Name="HostOverrideLabel" Style="{StaticResource Hint}" Margin="0,22,0,7"/>
            <ComboBox x:Name="HostChoice" Margin="0,0,0,8">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="225"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="SetHostButton" Style="{StaticResource QuietButton}" Click="SetHostButton_Click" Margin="0,0,0,8"/>
            <Button x:Name="ClearHostButton" Style="{StaticResource QuietButton}" Click="ClearHostButton_Click"/>
            <TextBlock x:Name="PresetStatus" Style="{StaticResource Hint}" Margin="0,23,0,0"/>
          </StackPanel></Border>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="680" HorizontalAlignment="Left">
          <Border Background="{StaticResource BrandGradient}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="19" Margin="0,0,0,22">
            <TextBlock x:Name="SettingsTitle" Style="{StaticResource Heading}"/>
          </Border>
          <Border Style="{StaticResource Panel}" Padding="22" Margin="0,0,0,14"><StackPanel>
            <TextBlock x:Name="LanguageHeading" Style="{StaticResource SectionHeading}" Margin="0,0,0,9"/>
            <ComboBox x:Name="LanguageChoice" Width="220" HorizontalAlignment="Left" SelectionChanged="LanguageChoice_SelectionChanged">
              <ComboBoxItem Content="English"/><ComboBoxItem Content="简体中文"/>
            </ComboBox>
            <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Panel}" Padding="22" Margin="0,0,0,14"><StackPanel>
            <TextBlock x:Name="MonitorLabel" Style="{StaticResource SectionHeading}" Margin="0,0,0,9"/>
            <ComboBox x:Name="MonitorChoice" Width="220" HorizontalAlignment="Left" SelectionChanged="MonitorChoice_SelectionChanged"/>
            <TextBlock x:Name="MonitorHint" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Panel}" Padding="22" Margin="0,0,0,14"><StackPanel>
            <CheckBox x:Name="StartupCheck" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
            <TextBlock x:Name="StartupError" Foreground="#FF8899" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Panel}" Padding="22"><StackPanel>
            <TextBlock x:Name="LogsHeading" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="OpenLogButton" Style="{StaticResource QuietButton}" Click="OpenLogButton_Click" Margin="0,0,8,0"/>
              <Button x:Name="OpenLogFolderButton" Style="{StaticResource QuietButton}" Click="OpenLogFolderButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="ServiceAddress" Foreground="{StaticResource Muted}" Margin="0,20,0,4"/>
            <TextBlock x:Name="ServiceStatus" Foreground="{StaticResource Ink}" Margin="0,0,0,10"/>
            <Button x:Name="CheckServiceButton" Style="{StaticResource QuietButton}" Click="CheckServiceButton_Click" HorizontalAlignment="Left"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
